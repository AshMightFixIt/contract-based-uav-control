Thumbs.db
.DS_Store

# Project specific
# The repository root is also the colcon workspace: never track the colcon
# artifacts (build/install/log) or the externally-cloned px4_msgs dependency.
/px4_msgs/
build/
install/
log/

# Claude Code: per-user settings and session worktrees stay local.
# (A shared .claude/settings.json can still be committed.)
.claude/settings.local.json
.claude/worktrees/
