<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>contract_uav_control</name>
  <version>0.1.0</version>
  <description>
    ROS 2 bridge that runs the contract-based three-tier (PID/MPC/H-inf) adaptive
    drone controller as a PX4 offboard node. Targets the DEXI / PX4 platform via
    micro-XRCE-DDS (px4_msgs).
  </description>
  <maintainer email="aswatths@umich.edu">Aswatth Sunil</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>contract_uav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
